# Supabase: Project Settings > Database > Connection string (use the Session pooler URI), then change the scheme to postgresql+psycopg2
DATABASE_URL=postgresql+psycopg2://postgres.xxxx:URL-ENCODED-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SECRET_KEY=generate-with-python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
TRUSTED_PROXY_HOPS=1   # production on Render: verify with scripts/check_deploy.sh
ALLOWED_ORIGIN=http://localhost:3000
RATELIMIT_STORAGE_URI=memory://

# Password reset emails (optional: without SMTP use `python manage.py reset-link EMAIL`)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
